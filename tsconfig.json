{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "src",
    "test",
    "scripts",
    "eval",
    "build.ts"
  ],
  "exclude": [
    "eval/tasks"
  ]
}
