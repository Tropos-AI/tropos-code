{
  "name": "tropos-code",
  "version": "0.1.0",
  "description": "Tropos Code — an agentic coding CLI by Tropos Labs",
  "private": true,
  "type": "module",
  "bin": {
    "tropos": "src/index.ts"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "test": "bun test",
    "test:coverage": "bun scripts/check-coverage.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build.ts",
    "build:all": "bun build.ts --all"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "diff": "9.0.0",
    "ink": "8.0.0",
    "marked": "15.0.12",
    "marked-terminal": "7.3.0",
    "react": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/diff": "^8.0.0",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "typescript": "5.9"
  }
}
